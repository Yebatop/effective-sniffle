# Ключ Anthropic. На Vercel вписывается в Environment Variables, сюда — только для запуска у себя.
ANTHROPIC_API_KEY=
# Пароль для входа в приложение (можно русскими буквами).
APP_PASSWORD=
# Строку базы подставляет интеграция Neon на Vercel. Для запуска у себя:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tolmach
